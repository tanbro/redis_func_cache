digraph DataStructure {
    bgcolor=transparent;
    node [shape=none, margin=0, fontname="Arial, Helvetica, sans-serif"];

    ds [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
            <TR>
                <TD BORDER="1" CELLPADDING="7" BGCOLOR="#e3f2fd" COLSPAN="2"><FONT POINT-SIZE="14"><B>Index</B>　<FONT FACE="monospace">…:0</FONT>　<FONT POINT-SIZE="10" COLOR="#555">ZSET</FONT></FONT></TD>
                <TD BORDER="0" WIDTH="46" ALIGN="CENTER"><FONT POINT-SIZE="10" COLOR="#999">member<br/>↦<br/>field</FONT></TD>
                <TD BORDER="1" CELLPADDING="7" BGCOLOR="#e3f2fd" COLSPAN="2"><FONT POINT-SIZE="14"><B>Data</B>　<FONT FACE="monospace">…:1</FONT>　<FONT POINT-SIZE="10" COLOR="#555">HASH</FONT></FONT></TD>
            </TR>
            <TR>
                <TD BORDER="1" BGCOLOR="#e3f2fd" WIDTH="110" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">hash_1</FONT></TD>
                <TD BORDER="1" BGCOLOR="#e8f5e9" WIDTH="90" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">score_1</FONT></TD>
                <TD BORDER="0" ALIGN="CENTER"><FONT POINT-SIZE="13" COLOR="#1565c0">↦</FONT></TD>
                <TD BORDER="1" BGCOLOR="#e3f2fd" WIDTH="110" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">hash_1</FONT></TD>
                <TD BORDER="1" BGCOLOR="#fff3e0" WIDTH="130" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">value_1</FONT></TD>
            </TR>
            <TR>
                <TD BORDER="1" BGCOLOR="#e3f2fd" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">hash_2</FONT></TD>
                <TD BORDER="1" BGCOLOR="#e8f5e9" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">score_2</FONT></TD>
                <TD BORDER="0" ALIGN="CENTER"><FONT POINT-SIZE="13" COLOR="#1565c0">↦</FONT></TD>
                <TD BORDER="1" BGCOLOR="#e3f2fd" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">hash_2</FONT></TD>
                <TD BORDER="1" BGCOLOR="#fff3e0" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">value_2</FONT></TD>
            </TR>
            <TR>
                <TD BORDER="1" BGCOLOR="#e3f2fd" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">hash_3</FONT></TD>
                <TD BORDER="1" BGCOLOR="#e8f5e9" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">score_3</FONT></TD>
                <TD BORDER="0" ALIGN="CENTER"><FONT POINT-SIZE="13" COLOR="#1565c0">↦</FONT></TD>
                <TD BORDER="1" BGCOLOR="#e3f2fd" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">hash_3</FONT></TD>
                <TD BORDER="1" BGCOLOR="#fff3e0" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">value_3</FONT></TD>
            </TR>
            <TR>
                <TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="10" COLOR="#999">…</FONT></TD>
                <TD BORDER="0"></TD>
                <TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="10" COLOR="#999">…</FONT></TD>
            </TR>
            <TR>
                <TD BORDER="1" BGCOLOR="#e3f2fd" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">hash_N</FONT></TD>
                <TD BORDER="1" BGCOLOR="#e8f5e9" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">score_N</FONT></TD>
                <TD BORDER="0" ALIGN="CENTER"><FONT POINT-SIZE="13" COLOR="#1565c0">↦</FONT></TD>
                <TD BORDER="1" BGCOLOR="#e3f2fd" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">hash_N</FONT></TD>
                <TD BORDER="1" BGCOLOR="#fff3e0" ALIGN="CENTER"><FONT POINT-SIZE="11" FACE="monospace">value_N</FONT></TD>
            </TR>
            <TR>
                <TD COLSPAN="5" ALIGN="CENTER" BGCOLOR="#f5f5f5"><FONT POINT-SIZE="10" COLOR="#555"><I>index member and hash field are the same <B>hash_value</B> computed by the hasher</I></FONT></TD>
            </TR>
        </TABLE>
    >];
}
